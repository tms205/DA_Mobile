# ================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO ỨNG DỤNG QUẢN LÝ TÀI CHÍNH
# ================================================================
# Hướng dẫn:
# 1. Sao chép file này thành file '.env' cùng thư mục gốc:
#    cp .env.example .env
# 2. Lấy Google Gemini API Key tại:
#    https://aistudio.google.com/app/apikey hoặc Google Cloud Console
#    (Hệ thống tự động tương thích cả key định dạng mới AQ.xxxx và AIzaSyxxxx)
# 3. Dán API Key vào giá trị GEMINI_API_KEY bên dưới:
# ================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) Chọn model cụ thể nếu muốn (Mặc định tự động chọn model mới nhất: gemini-2.5-flash, gemini-2.0-flash...)
# GEMINI_MODEL=gemini-2.5-flash
